---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <nav class="site-footer__links sds-text--content-small" aria-label="Legal">
    <a href="/privacy">Privacy Policy</a>
    <a href="/terms">Terms of Service</a>
  </nav>
  <p class="site-footer__legal sds-text--content-xsmall">
    © {year} Subliminal Design System LLC. All rights reserved. “Subliminal” is the brand name of
    Subliminal Design System LLC.
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem var(--sds-viewport-x-padding);
    border-top: 1px solid var(--sds-neutral-background-offset);
    color: var(--sds-neutral-content-tertiary);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .site-footer__links a {
    color: var(--sds-neutral-content-secondary);
  }

  .site-footer p {
    margin: 0;
  }
</style>
